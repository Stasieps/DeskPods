<Window x:Class="PodsView.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PodsView;component/Assets/deskpods.ico" Title="DeskPods Settings" Width="560" Height="700" MinWidth="560" MinHeight="400" MaxWidth="560" MaxHeight="700"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        TextElement.Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid Margin="28,24,28,22" TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
        <Rectangle Fill="{DynamicResource DotPattern}" Opacity="0.45" IsHitTestVisible="False" Margin="-28,-24,-28,-22" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Налаштування" FontFamily="{DynamicResource UiFont}" FontSize="{StaticResource FontHeadline}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel TextElement.Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,6,0">

                    <TextBlock x:Name="LanguageSectionText" Text="МОВА" Style="{StaticResource SectionLabel}" Margin="0,8,0,9" />
                    <Border Style="{StaticResource CardBorder}" Padding="17,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LanguageLabelText" Text="Мова інтерфейсу" FontFamily="{DynamicResource UiFont}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock x:Name="LanguageHintText" Text="Змінюється одразу після збереження." Style="{StaticResource HintText}" Margin="0,4,18,0" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageComboBox" AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabelText}" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Language_Changed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="17,14" Margin="0,9,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ThemeLabelText" Text="Оформлення" FontFamily="{DynamicResource UiFont}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock x:Name="ThemeHintText" Text="Застосовується одразу." Style="{StaticResource HintText}" Margin="0,4,18,0" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeComboBox" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabelText}" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Theme_Changed" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="CardSectionText" Text="КАРТКА" Style="{StaticResource SectionLabel}" Margin="0,18,0,9" />
                    <Border Style="{StaticResource CardBorder}" Padding="17,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="HotkeyLabelText" Text="Гаряча клавіша картки" FontFamily="{DynamicResource UiFont}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock x:Name="HotkeyHintText" Text="Натисни свою комбінацію. Esc — вимкнути." Style="{StaticResource HintText}" Margin="0,4,18,0" />
                            </StackPanel>
                            <TextBox x:Name="HotkeyBox" AutomationProperties.LabeledBy="{Binding ElementName=HotkeyLabelText}" Grid.Column="1" VerticalAlignment="Center" IsReadOnly="True"
                                     TextAlignment="Center" PreviewKeyDown="Hotkey_PreviewKeyDown" ToolTip="Ctrl+Alt+P" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="BehaviorSectionText" Text="ПОВЕДІНКА" Style="{StaticResource SectionLabel}" Margin="0,18,0,9" />
                    <Border Style="{StaticResource CardBorder}" Padding="17,4">
                        <StackPanel>
                            <Grid Margin="0,11">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="StartWithWindowsCheckBox" Content="Запускати разом із Windows" Checked="StartupCheckChanged" Unchecked="StartupCheckChanged" />
                                <TextBlock x:Name="StartWithWindowsHintText" Grid.Row="1" Style="{StaticResource HintText}" Text="DeskPods буде готовий до підключення навушників." Margin="24,4,0,0" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource HairlineBrush}" />
                            <Grid Margin="0,11">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="StartMinimizedCheckBox" Content="Стартувати тихо в треї" />
                                <TextBlock x:Name="StartMinimizedHintText" Grid.Row="1" Style="{StaticResource HintText}" Text="Без великого вікна поверх робочого столу." Margin="24,4,0,0" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource HairlineBrush}" />
                            <Grid Margin="0,11">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Закриття ховає застосунок" />
                                <TextBlock x:Name="MinimizeToTrayHintText" Grid.Row="1" Style="{StaticResource HintText}" Text="Моніторинг продовжить працювати у фоні." Margin="24,4,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="NotificationsSectionText" Text="СПОВІЩЕННЯ" Style="{StaticResource SectionLabel}" Margin="0,18,0,9" />
                    <Border Style="{StaticResource CardBorder}" Padding="17,4">
                        <StackPanel>
                            <Grid Margin="0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <CheckBox x:Name="NotificationsCheckBox" Content="Низький заряд" />
                                    <TextBlock x:Name="NotificationsHintText" Style="{StaticResource HintText}" Text="Одне корисне сповіщення, без спаму." Margin="24,4,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="ThresholdComboBox" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource HairlineBrush}" />
                            <Grid Margin="0,11">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="NearbyCheckBox" Content="Бачити кейс до підключення" />
                                <TextBlock x:Name="NearbyHintText" Grid.Row="1" Style="{StaticResource HintText}" Text="Працює лише зі сильним сигналом уже спареної моделі." Margin="24,4,0,0" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource HairlineBrush}" />
                            <!-- 0.8.46: the only network request the app makes. -->
                            <Grid Margin="0,11">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="UpdatesCheckBox" Content="Перевіряти оновлення" />
                                <TextBlock x:Name="UpdatesHintText" Grid.Row="1" Style="{StaticResource HintText}" Text="Раз на 6 годин питає GitHub про нову версію. Більше нічого не надсилається." Margin="24,4,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="AboutSectionText" Style="{StaticResource SectionLabel}" Margin="0,20,0,10" />
                    <Border Style="{StaticResource CardBorder}" Padding="17,14">
                        <StackPanel>
                            <TextBlock x:Name="AboutModelText" FontFamily="{DynamicResource UiFont}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="AboutHintText" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,14" />
                            <Button x:Name="SupportButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="Support_Click" MinHeight="40">
                                <TextBlock x:Name="SupportButtonText" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Export is sanitized and runs outside the UI thread. -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="Export_Click" Padding="12,7">
                    <TextBlock x:Name="ExportButtonText" Text="Експорт логів (zip)" Foreground="{DynamicResource PrimaryTextBrush}" />
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0">
                        <TextBlock x:Name="CancelButtonText" Text="Скасувати" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="Save_Click">
                        <TextBlock x:Name="SaveButtonText" Text="Зберегти" Foreground="{DynamicResource CanvasBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
