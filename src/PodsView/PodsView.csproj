<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PodsView</AssemblyName>
    <RootNamespace>PodsView</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\deskpods.ico</ApplicationIcon>
    <Version>0.8.46</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Company>DeskPods</Company>
    <Product>DeskPods</Product>
    <AssemblyTitle>DeskPods</AssemblyTitle>
    <Description>DeskPods — AirPods battery on your Windows desktop</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\support-url.txt" Link="support-url.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\support-url.txt')" />
    <Resource Include="Assets\deskpods.ico" />
    <Resource Include="Assets\airpods-product.png" />
    <Resource Include="Assets\airpods-case-open.png" />
    <Resource Include="Assets\airpods-turn-atlas.png" />
    <Resource Include="Assets\airpods-turn-still.png" />
    <EmbeddedResource Include="Assets\deskpods.ico">
      <LogicalName>DeskPods.Brand.Icon</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Tray\case-light-normal.ico">
      <LogicalName>DeskPods.Tray.Light</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Tray\case-dark-normal.ico">
      <LogicalName>DeskPods.Tray.Dark</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
