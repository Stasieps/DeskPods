<Window x:Class="PodsView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/PodsView;component/Assets/deskpods.ico" Title="DeskPods" Width="540" Height="244" MinWidth="540" MinHeight="244"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        KeyDown="Window_KeyDown">

    <!-- 0.8.18: the detail view is gone. It carried LIVE TELEMETRY, BALANCE, SIGNAL
         and COPY, none of which said anything the three numbers do not. One window,
         one job. Settings holds everything else. -->
    <!-- UseLayoutRounding puts every edge on a whole pixel and Display formatting puts
         every glyph stem on one too. Without them a thin bar and an 11 px label land on
         half pixels, and the card reads as slightly soft and misaligned - which is what
         "not tidy" actually looks like at 100% scaling. -->
    <Border x:Name="AppearanceFrame" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            CornerRadius="16" ClipToBounds="True" MouseLeftButtonDown="Shell_MouseLeftButtonDown"
            UseLayoutRounding="True" SnapsToDevicePixels="True"
            TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
        <Grid x:Name="AppearanceContent" TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
            <!-- The dot field is dense against the left edge and fades out towards the
                 right. The alpha ramp lives in App.xaml so this file holds no colours. -->
            <Rectangle Fill="{DynamicResource DotPattern}" IsHitTestVisible="False" OpacityMask="{StaticResource DotFadeMask}" />

            <Grid x:Name="CompactRoot" Margin="20,16,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="132" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CompactDeviceNameText" Text="AirPods" Style="{StaticResource TitleText}" MaxWidth="290" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Border x:Name="CompactConnectionDot" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource InfoBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompactConnectionText" Text="..." Style="{StaticResource StatusLabel}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- 0.8.23: the refresh button is gone. The card is fed by a passive
                         radio listener that never stops, so the button only restarted a
                         scan that was already running - it could not make a silent case
                         talk. The R key still restarts the scan for the rare case where
                         the Bluetooth stack itself wedges. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ShellSettingsButton" AutomationProperties.Name="Settings" Style="{StaticResource GhostButton}" Click="Settings_Click" Padding="9,6" MinHeight="30" ToolTip="Settings (S)">
                            <Canvas Width="15" Height="15">
                                <Path Style="{StaticResource IconPath}" Data="M 1,4 L 14,4 M 1,8 L 14,8 M 1,12 L 14,12" />
                                <Ellipse Canvas.Left="8.4" Canvas.Top="2.4" Width="3.2" Height="3.2" Fill="{DynamicResource PrimaryTextBrush}" />
                                <Ellipse Canvas.Left="3.4" Canvas.Top="6.4" Width="3.2" Height="3.2" Fill="{DynamicResource PrimaryTextBrush}" />
                                <Ellipse Canvas.Left="9.4" Canvas.Top="10.4" Width="3.2" Height="3.2" Fill="{DynamicResource PrimaryTextBrush}" />
                            </Canvas>
                        </Button>
                        <Button x:Name="ShellCloseButton" AutomationProperties.Name="Close" Style="{StaticResource GhostButton}" Click="ShellClose_Click" Padding="9,6" MinHeight="30" Margin="2,0,0,0" ToolTip="Close">
                            <Canvas Width="12" Height="12">
                                <Path Style="{StaticResource IconPath}" Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{DynamicResource SecondaryTextBrush}" />
                            </Canvas>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Body: the real photo of the case on the left (the one from the repo,
                     variant A), three channels on the right. Geometry is the measured
                     compact tile; only the value column grew to fit "80-89 %". -->
                <Grid x:Name="AppearanceBody" Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AppearanceProductTile" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True" VerticalAlignment="Stretch">
                        <Grid>
                            <!-- 0.8.25: the pool of light under the case drifts against the turn, so the
                                 tile reads as lit from one side instead of sliding about. -->
                            <Ellipse Margin="-14,18,-14,-22" Opacity="0.22" Fill="{DynamicResource ProductGlow}">
                            </Ellipse>
                            <!-- Photo-derived turntable. Preview and app use the same pre-rendered frames.
                                 No separate highlight mask can drift outside the product silhouette. -->
                            <Image x:Name="ProductImage" Source="Assets/airpods-turn-still.png"
                                   Stretch="Uniform" IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="AppearanceLeftRow" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AppearanceLeftTag" Style="{StaticResource TagBox}" VerticalAlignment="Center">
                                <TextBlock x:Name="CompactLeftLabel" Text="L" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border x:Name="AppearanceLeftTrack" Grid.Column="2" Style="{StaticResource TrackBorder}" Height="4" CornerRadius="2" VerticalAlignment="Center">
                                <Border x:Name="CompactLeftFill" Background="{DynamicResource OkBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="CompactLeftScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <TextBlock x:Name="CompactLeftValueText" Grid.Column="3" Text="-" Style="{StaticResource ValueText}" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <Border Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource HairlineBrush}" Opacity="0.5" IsHitTestVisible="False" />
                        </Grid>

                        <Grid x:Name="AppearanceRightRow" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AppearanceRightTag" Style="{StaticResource TagBox}" VerticalAlignment="Center">
                                <TextBlock x:Name="CompactRightLabel" Text="R" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border x:Name="AppearanceRightTrack" Grid.Column="2" Style="{StaticResource TrackBorder}" Height="4" CornerRadius="2" VerticalAlignment="Center">
                                <Border x:Name="CompactRightFill" Background="{DynamicResource OkBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="CompactRightScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <TextBlock x:Name="CompactRightValueText" Grid.Column="3" Text="-" Style="{StaticResource ValueText}" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <Border Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource HairlineBrush}" Opacity="0.5" IsHitTestVisible="False" />
                        </Grid>

                        <Grid x:Name="AppearanceCaseRow" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AppearanceCaseTag" Style="{StaticResource TagBox}" VerticalAlignment="Center">
                                <TextBlock x:Name="CompactCaseLabel" Text="C" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border x:Name="AppearanceCaseTrack" Grid.Column="2" Style="{StaticResource TrackBorder}" Height="4" CornerRadius="2" VerticalAlignment="Center">
                                <Border x:Name="CompactCaseFill" Background="{DynamicResource OkBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="CompactCaseScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <TextBlock x:Name="CompactCaseValueText" Grid.Column="3" Text="-" Style="{StaticResource ValueText}" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Footer: the running build, written from App.Version when the window
                     loads. No number lives in this file, because a hardcoded one sat here
                     at v0.8.12 while 0.8.13 was running. The fill of the pill is opaque, so
                     the dot field stops at its border instead of running through the digits.
                     0.8.22: the right-hand corner is empty on purpose. It carried the age of
                     the reading, which is one more line to read on a card whose whole point
                     is three numbers. -->
                <!-- 0.8.46: the same pill turns into the update button once GitHub has a newer
                     release: "v0.8.45 · Оновити до 0.8.46", one click downloads and installs. -->
                <Border x:Name="VersionChip" Grid.Row="2" Style="{StaticResource VersionChip}" MouseLeftButtonDown="VersionChip_MouseLeftButtonDown">
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource VersionChipText}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
